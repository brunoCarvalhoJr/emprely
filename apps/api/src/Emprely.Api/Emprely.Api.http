@Emprely.Api_HostAddress = http://localhost:5262
@accessToken = cole-o-token-aqui

GET {{Emprely.Api_HostAddress}}/health
Accept: application/json

###

POST {{Emprely.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "nome": "Bruno Carvalho",
  "email": "bruno@emprely.dev",
  "senha": "Senha123",
  "nomeConta": "Emprely"
}

###

POST {{Emprely.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "bruno@emprely.dev",
  "senha": "Senha123"
}

###

GET {{Emprely.Api_HostAddress}}/api/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{Emprely.Api_HostAddress}}/api/account
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{Emprely.Api_HostAddress}}/api/account/profile
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{Emprely.Api_HostAddress}}/api/account/profile
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nomeComercial": "Emprely",
  "emailContato": "contato@emprely.dev",
  "telefoneContato": "+55 11 99999-9999",
  "siteUrl": "https://emprely.com",
  "instagram": "@emprely",
  "documento": "00.000.000/0001-00",
  "corPrimaria": "#2563EB",
  "corSecundaria": "#14B8A6",
  "logoUrl": "https://emprely.com/logo.png"
}

###

GET {{Emprely.Api_HostAddress}}/api/customers
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{Emprely.Api_HostAddress}}/api/customers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nome": "Maria Cliente",
  "email": "maria@cliente.com",
  "telefone": "+55 11 99999-9999",
  "documento": "123.456.789-00",
  "observacoes": "Cliente recorrente de social media."
}

###

GET {{Emprely.Api_HostAddress}}/api/services
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{Emprely.Api_HostAddress}}/api/services
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "nome": "Pacote Social Media",
  "descricao": "Planejamento, criativos e publicacao mensal.",
  "categoria": "Social Media",
  "preco": 1200.00,
  "unidade": "Mensal",
  "tipo": "Pacote"
}

###

GET {{Emprely.Api_HostAddress}}/api/proposals
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{Emprely.Api_HostAddress}}/api/proposals
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "clienteId": "cole-o-cliente-id-aqui",
  "titulo": "Proposta Social Media",
  "introducao": "Plano mensal para presenca digital.",
  "observacoes": "Validade de 7 dias.",
  "validadeDias": 7,
  "itens": [
    {
      "servicoId": "cole-o-servico-id-aqui",
      "nome": "Pacote Social Media",
      "descricao": "Planejamento, criativos e publicacao mensal.",
      "quantidade": 1,
      "valorUnitario": 1200.00
    }
  ]
}
