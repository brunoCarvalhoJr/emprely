{
  "name": "emprely",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "web:build:beta": "powershell -ExecutionPolicy Bypass -File scripts/build-web-beta.ps1",
    "web:deploy:s3": "powershell -ExecutionPolicy Bypass -File scripts/deploy-web-s3.ps1",
    "landing:dev": "pnpm --dir apps/landing dev",
    "landing:check": "pnpm --dir apps/landing check",
    "landing:build": "pnpm --dir apps/landing build",
    "landing:deploy:prod": "pnpm --dir apps/landing deploy:prod",
    "lint:web": "pnpm --dir apps/web lint",
    "test:e2e:web": "node scripts/run-web-e2e.mjs",
    "build:api": "dotnet build apps/api/Emprely.sln",
    "test:api": "dotnet test apps/api/Emprely.sln",
    "validate": "pnpm lint:web && pnpm build:web && dotnet build apps/api/Emprely.sln && dotnet test apps/api/Emprely.sln",
    "validate:beta": "pnpm lint:web && pnpm build:web && node scripts/run-web-e2e.mjs && dotnet build apps/api/Emprely.sln && dotnet test apps/api/Emprely.sln --no-build && docker compose config",
    "validate:deploy": "docker compose -f infra/docker/docker-compose.beta.example.yml --env-file infra/docker/beta.env.example config",
    "validate:deploy:runtime": "powershell -ExecutionPolicy Bypass -File scripts/validate-beta-runtime.ps1",
    "beta:env:new": "powershell -ExecutionPolicy Bypass -File scripts/new-beta-env.ps1",
    "beta:env:domains": "powershell -ExecutionPolicy Bypass -File scripts/set-beta-domains.ps1",
    "beta:env:validate": "powershell -ExecutionPolicy Bypass -File scripts/validate-beta-env.ps1",
    "beta:env:validate:public": "powershell -ExecutionPolicy Bypass -File scripts/validate-beta-env.ps1 -RequirePublicUrls",
    "lightsail:env:validate": "powershell -ExecutionPolicy Bypass -File scripts/validate-lightsail-env.ps1 -EnvPath ..\\..\\Segredos\\lightsail.env",
    "lightsail:asaas:sandbox": "powershell -ExecutionPolicy Bypass -File scripts/import-asaas-secrets-to-lightsail-env.ps1 -Environment Sandbox",
    "lightsail:asaas:prod": "powershell -ExecutionPolicy Bypass -File scripts/import-asaas-secrets-to-lightsail-env.ps1 -Environment Production",
    "lightsail:api:build": "powershell -ExecutionPolicy Bypass -File scripts/build-lightsail-api-image.ps1",
    "lightsail:api:deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-lightsail-api-image.ps1",
    "validate:lightsail": "powershell -ExecutionPolicy Bypass -File scripts/validate-lightsail-env.ps1 -EnvPath infra/lightsail/lightsail.env.example -AllowPlaceholders && docker compose -f infra/lightsail/docker-compose.api.yml --env-file infra/lightsail/lightsail.env.example config",
    "validate:mvp": "pnpm validate:beta && pnpm validate:deploy && pnpm validate:lightsail"
  }
}
